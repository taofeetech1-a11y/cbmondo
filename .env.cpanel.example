APP_NAME="CBM Ondo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_cbmondo
DB_USERNAME=cpaneluser_cbm
DB_PASSWORD="REPLACE_ON_SERVER"
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=cbmondo_production_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# Configure real SMTP before relying on email/password-reset delivery.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="CBM Ondo"

# Optional Google Search Console HTML-tag verification value.
GOOGLE_SITE_VERIFICATION=
